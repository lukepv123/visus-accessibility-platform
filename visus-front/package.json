{
    "name": "visus",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev:web": "npm --workspace apps/web run dev",
        "dev:mobile": "npm --workspace apps/mobile run start",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check .",
        "fix": "biome check --write .",
        "typecheck": "tsc --noEmit -p apps/web/tsconfig.app.json && tsc --noEmit -p apps/mobile/tsconfig.json",
        "gen:api": "npm -w packages/api run gen"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.4"
    },
    "dependencies": {
        "@react-pdf/renderer": "^4.3.1",
        "node": "^25.2.0",
        "recharts": "^3.4.1"
    }
}
